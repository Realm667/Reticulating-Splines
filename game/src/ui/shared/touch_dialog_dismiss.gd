class_name TouchDialogDismiss
extends Node
## Outside taps request the same cancellation as the window's close button.
## Keep the window open until release has finished routing, so neither the
## contact nor Godot's emulated mouse can reach controls or tools behind it.

const TAP_SLOP := 12.0

class InputGuard extends Node:
	var router: TouchDialogDismiss

	func _input(event: InputEvent) -> void:
		if router.consumes(event):
			get_viewport().set_input_as_handled()

var root: Window
var _contacts: Dictionary[int, Vector2] = {}
var _outside: Dictionary[int, Dictionary] = {}
var _multiple := false
var _serial := 0


func attach(window: Window) -> void:
	root = window
	root.window_input.connect(observe)
	get_tree().node_added.connect(_node_added)
	for child in root.find_children("*", "Window", true, false):
		_node_added(child)


func _notification(what: int) -> void:
	if what == MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT:
		_contacts.clear()
		_outside.clear()
		_multiple = false


func _node_added(node: Node) -> void:
	if node is Window and node != root:
		if node.has_node("TouchDismissInput"):
			return
		var guard := InputGuard.new()
		guard.name = "TouchDismissInput"
		guard.router = self
		node.add_child.call_deferred(guard)


func _input(event: InputEvent) -> void:
	if consumes(event):
		get_viewport().set_input_as_handled()


func consumes(event: InputEvent) -> bool:
	if event is InputEventScreenTouch or event is InputEventScreenDrag:
		return _outside.has(event.index)
	return event is InputEventMouse and event.device == -1 and not _outside.is_empty()


func observe(event: InputEvent) -> void:
	if root == null or not root.gui_embed_subwindows:
		return
	if event is InputEventScreenTouch:
		if event.pressed:
			if _contacts.is_empty():
				_multiple = false
			_contacts[event.index] = event.position
			_multiple = _multiple or _contacts.size() > 1
			var window := _top_window()
			if window != null and not HoverFocusRouter._frame(window).has_point(Vector2i(
				HoverFocusRouter.viewport_point(event.position, root.get_final_transform()))):
				_serial += 1
				_outside[event.index] = {"window": weakref(window), "start": event.position, "moved": false, "serial": _serial}
		else:
			_contacts.erase(event.index)
			if _outside.has(event.index):
				var contact: Dictionary = _outside[event.index]
				var tap: bool = not event.canceled and not _multiple and not contact.moved and event.position.distance_to(contact.start) <= TAP_SLOP
				# Defer both release consumption cleanup and cancellation, including
				# any emulated mouse release generated by this contact.
				_finish.call_deferred(event.index, contact, tap)
	elif event is InputEventScreenDrag and _outside.has(event.index):
		if event.position.distance_to(_outside[event.index].start) > TAP_SLOP:
			_outside[event.index].moved = true


func _finish(index: int, contact: Dictionary, tap: bool) -> void:
	if _outside.get(index, {}).get("serial", -1) != contact.serial:
		return
	_outside.erase(index)
	var window := contact.window.get_ref() as Window
	if tap and is_instance_valid(window) and window.visible and _top_window() == window:
		# A real close sends a notification as well as close_requested. Built-in
		# AcceptDialog/FileDialog cancellation lives in that notification.
		window.notification(NOTIFICATION_WM_CLOSE_REQUEST)
		window.close_requested.emit()


func _top_window() -> Window:
	var focused: Window
	var candidate: Window
	for window: Window in root.find_children("*", "Window", true, false):
		if not window.visible or window.mouse_passthrough or not window.is_embedded():
			continue
		# Let menus and dropdowns perform their existing outside cancellation.
		if window is Popup:
			return null
		if window.has_focus():
			focused = window
		if candidate == null or window.exclusive or candidate.is_ancestor_of(window):
			candidate = window
	var result := focused if focused != null else candidate
	if result == null or (not result is AcceptDialog and result.get_signal_connection_list(&"close_requested").is_empty()):
		return null
	return result
